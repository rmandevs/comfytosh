    "button.secondaryBackground": "#343b37",
    "button.secondaryForeground": "#d6e8c8",
    "button.secondaryHoverBackground": "#3c4641",
    "checkbox.background": "#222623",
    "checkbox.border": "#7e8f85",
    "checkbox.foreground": "#d6e8c8",
    "badge.background": "#ff773d",
    "badge.foreground": "#282e2b",
    "progressBar.background": "#ff773d",
    "list.activeSelectionBackground": "#7cd3a238",
    "list.activeSelectionForeground": "#d6e8c8",
    "list.inactiveSelectionBackground": "#3c4641",
    "list.inactiveSelectionForeground": "#d6e8c8",
    "list.hoverBackground": "#ffffff0f",
    "list.focusOutline": "#7cd3a2",
    "list.highlightForeground": "#ff773d",
    "list.errorForeground": "#ff6b6b",
    "list.warningForeground": "#e59f71",
    "tree.indentGuidesStroke": "#7e8f85",
    "menu.background": "#3c4641",
    "menu.foreground": "#d6e8c8",
    "menu.selectionBackground": "#7cd3a238",
    "menu.selectionForeground": "#d6e8c8",
    "menu.separatorBackground": "#3c4641",
    "menu.border": "#7e8f85",
    "notifications.background": "#3c4641",
    "notifications.foreground": "#d6e8c8",
    "notifications.border": "#7e8f85",
    "notificationCenterHeader.background": "#343b37",
    "breadcrumb.foreground": "#bac1b8",
    "breadcrumb.focusForeground": "#d6e8c8",
    "breadcrumb.activeSelectionForeground": "#d6e8c8",
    "breadcrumbPicker.background": "#3c4641",
    "scrollbarSlider.background": "#7e8f8533",
    "scrollbarSlider.hoverBackground": "#7e8f8566",
    "scrollbarSlider.activeBackground": "#7e8f8599",
    "peekView.border": "#7e8f85",
    "peekViewEditor.background": "#343b37",
    "peekViewResult.background": "#222623",
    "peekViewTitle.background": "#343b37",
    "peekViewTitleLabel.foreground": "#d6e8c8",
    "peekViewTitleDescription.foreground": "#bac1b8",
    "peekViewEditor.matchHighlightBackground": "#e8d59547",
    "peekViewResult.matchHighlightBackground": "#e8d59547",
