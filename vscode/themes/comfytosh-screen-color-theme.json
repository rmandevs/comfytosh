    "terminal.ansiBlack": "#3c4641",
    "terminal.ansiRed": "#ff6b6b",
    "terminal.ansiGreen": "#7cd3a2",
    "terminal.ansiYellow": "#e8d595",
    "terminal.ansiBlue": "#a9dfbf",
    "terminal.ansiMagenta": "#c5f899",
    "terminal.ansiCyan": "#7cd3a2",
    "terminal.ansiWhite": "#bac1b8",
    "terminal.ansiBrightBlack": "#7e8f85",
    "terminal.ansiBrightRed": "#ff6b6b",
    "terminal.ansiBrightGreen": "#7cd3a2",
    "terminal.ansiBrightYellow": "#e8d595",
    "terminal.ansiBrightBlue": "#a9dfbf",
    "terminal.ansiBrightMagenta": "#c5f899",
    "terminal.ansiBrightCyan": "#7cd3a2",
    "terminal.ansiBrightWhite": "#d6e8c8"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#bac1b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#bac1b8"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "keyword.operator.logical.python",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#c5f899"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7cd3a2"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7cd3a2"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.character"
      ],
      "settings": {
        "foreground": "#e59f71"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#ff773d"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.enummember",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#e59f71"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#a9dfbf"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#e8d595"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.other.attribute-name",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#7cd3a2"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#bac1b8"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.language"
      ],
      "settings": {
        "foreground": "#d6e8c8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#a9dfbf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#7cd3a2"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#ff773d",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#bac1b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#c5f899"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7cd3a2"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff6b6b"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#a9dfbf"
      }
    }
  ]
}
