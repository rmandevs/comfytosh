    "terminal.foreground": "#d6e8c8",
    "terminalCursor.foreground": "#c5f899",
    "terminal.selectionBackground": "#7cd3a238",
    "terminal.findMatchBackground": "#e8d59547",
    "terminal.border": "#3c4641",
