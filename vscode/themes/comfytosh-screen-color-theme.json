    "gitDecoration.modifiedResourceForeground": "#a9dfbf",
    "gitDecoration.deletedResourceForeground": "#ff6b6b",
    "gitDecoration.untrackedResourceForeground": "#7cd3a2",
    "gitDecoration.conflictingResourceForeground": "#e59f71",
    "gitDecoration.ignoredResourceForeground": "#bac1b8",
